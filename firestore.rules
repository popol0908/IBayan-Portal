rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user is the owner of a document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      // Admins can read all profiles
      allow read: if isAdmin();
      // Allow any authenticated user to query for admins (needed for sending notifications)
      allow read: if isAuthenticated() && resource.data.role == 'admin';
      // Users can create their own profile during signup
      allow create: if isOwner(userId);
      // Users can update their own profile
      allow update: if isOwner(userId);
      // Admins can update any profile
      allow update: if isAdmin();
      // Admins can delete users
      allow delete: if isAdmin();
    }
    
    // Announcements collection
    match /announcements/{announcementId} {
      // Everyone can read announcements (including public unauthenticated users on the landing page)
      allow read: if true;
      // Only admins can create, update, or delete
      allow create, update, delete: if isAdmin();
    }
    
    // Chat messages collection (optional, for AI chat)
    match /chatMessages/{messageId} {
      // Users can read their own messages
      allow read: if isOwner(resource.data.userId);
      // Admins can read all messages
      allow read: if isAdmin();
      // Users can create their own messages
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      // Only admins can delete messages
      allow delete: if isAdmin();
    }
    
    // Events collection
    match /events/{eventId} {
      // Everyone can read events
      allow read: if isAuthenticated();
      // Only admins can create, update, or delete
      allow create, update, delete: if isAdmin();
    }
    
    // Event Registrations collection
    match /eventRegistrations/{registrationId} {
      // Users can read all registrations (needed for registration counts and checking if user registered)
      allow read: if isAuthenticated();
      // Users can create their own registrations
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid;
      // Only admins can update or delete registrations
      allow update, delete: if isAdmin();
    }
    
    // Households collection
    match /households/{householdId} {
      // Users can read their own household profile
      allow read: if isAuthenticated() && resource.data.submittedBy == request.auth.uid;
      // Admins can read all households
      allow read: if isAdmin();
      // Users can create a household
      allow create: if isAuthenticated() && request.resource.data.submittedBy == request.auth.uid;
      // Admins can update or delete
      allow update, delete: if isAdmin();
    }
    
    // Metadata collection (for sequential IDs like householdCounter)
    match /metadata/{documentId} {
      // Authenticated users need to read, update, and create the counter using transactions
      // (create is needed if the document doesn't exist yet for the very first household)
      allow read, update, create: if isAuthenticated();
      // Only admins can delete metadata docs
      allow delete: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Authenticated users can create notifications (batch writes for all users)
      allow create: if isAuthenticated();
      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // No deletes
      allow delete: if isAdmin();
    }

    // Activity logs collection
    match /activityLogs/{logId} {
      // Admins can create and read activity logs
      allow create, read: if isAdmin();
      allow update, delete: if false;
    }

    // Audit logs collection (immutable audit trail)
    match /auditLogs/{logId} {
      // Admins can create and read audit logs
      allow create, read: if isAdmin();
      // Audit logs are immutable — no updates or deletes
      allow update, delete: if false;
    }

    // Archived collections - for historical data and auditing
    // Pattern: archived_{collectionName}
    match /{collectionName}/{documentId} {
      // Only admins can create archived records (during deletion)
      allow create: if collectionName.matches('^archived_.*') && isAdmin();
      // Only admins can read archived records (for auditing and analytics)
      allow read: if collectionName.matches('^archived_.*') && isAdmin();
      // Archived records should not be updated or deleted
      allow update, delete: if false;
    }
    
    // Default: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

